# Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/

# Datos de runtime del Pillbox (estado local de la Pi)
pillbox_data.json

# Salida de Medibot en la maquina donde corre (no es codigo)
videos/
data/
trainer.yml
trainer_labels.json

# Salida del verificador de WhatsApp (resultados, no codigo)
verificador-whatsapp/resultados.csv
verificador-whatsapp/resultados.txt

# CREDENCIALES - nunca al repositorio.
#  Un token de Cloudflare da permiso de Edit sobre el DNS y los tuneles: quien
#  lo tenga puede repuntar el dominio a donde quiera. Y un token publicado en
#  GitHub se queda en el historial de git aunque luego se borre el fichero.
#  Los ficheros de credenciales van FUERA del repo (~/.medibot/), pero estas
#  reglas estan aqui como red por si alguno acaba dentro por descuido.
*.token
*_token.txt
.env
.env.*
cf_token*
cloudflared/
*.pem
credenciales*.json
#  La sesion de whatsapp-web.js (LocalAuth): equivale a tener la cuenta
#  iniciada, asi que tampoco puede acabar en el repositorio.
.wwebjs_auth/
.wwebjs_cache/

# Productos del banco de pruebas del firmware (no son codigo)
pruebas/banco_firmware/.build/
pruebas/banco_firmware/.libs/
pruebas/banco_firmware/nvs*.dat*
